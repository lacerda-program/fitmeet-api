<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005" author="samuel">
        <createTable tableName="activity_participants">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="activity_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_participants_activity"
                             references="activities(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_participants_user"
                             references="users(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="ENROLLED">
                <constraints nullable="false"/>
            </column>
            <column name="enrolled_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
